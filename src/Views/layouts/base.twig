<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Espaço Vital Clínica{% endblock %}</title>
    <link rel="stylesheet" href="/style.css">
    {% block head %}{% endblock %}
</head>
<body>
    {% if not hide_header %}
    <header class="site-header">
        <div class="header-inner">
            <div class="logo-area">
                <img src="/img/logo.png" alt="Logo" class="logo-img" onerror="this.style.display='none'">
                <div class="logo-text">
                    <span class="system-name">Espaço Vital</span>
                    <span class="system-subtitle">Sistema de Gestão</span>
                </div>
            </div>

            {% if not hide_nav %}
            <div class="user-area" style="margin-left:auto; margin-right:20px; color:var(--text-muted); font-size:0.9rem;">
                Olá, <strong>{{ session_user_email.usuario_email|default('Usuário') }}</strong>
            </div>

            <nav class="main-nav">
                <a href="/dashboard" class="{{ currentRoute == 'dashboard' ? 'active' : '' }}">Dashboard</a>

                <a href="{{ permissions.checkin ? '/checkin' : '#' }}"
                    onclick="{{ permissions.checkin ? '' : "alert('Acesso negado'); return false;" }}"
                    class="{{ currentRoute == 'checkin' ? 'active' : '' }}">Check-in</a>

                <a href="{{ permissions.pacotes ? '/pacotes' : '#' }}"
                    onclick="{{ permissions.pacotes ? '' : "alert('Acesso negado'); return false;" }}"
                    class="{{ currentRoute == 'pacotes' ? 'active' : '' }}">Pacotes</a>

                <a href="{{ permissions.relatorios ? '/relatorios' : '#' }}"
                    onclick="{{ permissions.relatorios ? '' : "alert('Acesso negado'); return false;" }}"
                    class="{{ currentRoute == 'relatorios' ? 'active' : '' }}">Relatórios</a>

                <div class="nav-item-dropdown">
                    <a href="#" class="dropdown-toggle {{ currentRoute in ['profissionais', 'salas', 'usuarios'] ? 'active' : '' }}" onclick="return false;">
                        Cadastros <span style="font-size: 0.8em; margin-left: 2px;">▼</span>
                    </a>
                    <div class="dropdown-menu">
                        <a href="{{ permissions.profissionais ? '/profissionais' : '#' }}"
                            onclick="{{ permissions.profissionais ? '' : "alert('Acesso negado'); return false;" }}"
                            class="{{ currentRoute == 'profissionais' ? 'active' : '' }}">Profissionais</a>

                        <a href="{{ permissions.salas ? '/salas' : '#' }}"
                            onclick="{{ permissions.salas ? '' : "alert('Acesso negado'); return false;" }}"
                            class="{{ currentRoute == 'salas' ? 'active' : '' }}">Salas</a>

                        <a href="{{ permissions.usuarios ? '/usuarios' : '#' }}"
                            onclick="{{ permissions.usuarios ? '' : "alert('Acesso negado'); return false;" }}"
                            class="{{ currentRoute == 'usuarios' ? 'active' : '' }}">Usuários</a>
                    </div>
                </div>

                <a href="#" onclick="alert('Em breve'); return false;">Configurações</a>
                <a href="/logout">Sair</a>
            </nav>
            {% endif %}
        </div>
    </header>
    {% endif %}

    {% block body %}
    <main class="container">
        {% block content %}{% endblock %}
    </main>
    {% endblock %}

    {% block scripts %}{% endblock %}
</body>
</html>
