{% extends "layouts/base.twig" %}

{% block title %}Serviços - Espaço Vital{% endblock %}

{% block content %}
<div class="topbar">
    <h1>Cadastro de Serviços</h1>
    {% if editando %}
        <a href="{{ base_url }}/servicos" class="btn-secondary">Voltar para Novo</a>
    {% endif %}
</div>

{% if mensagem %}
    <div class="msg-alerta" style="background-color:#d1fae5; border-color:#10b981; color:#065f46;">
        {{ mensagem }}
    </div>
{% endif %}

{% if erro %}
    <div class="msg-alerta" style="background-color:#fee2e2; border-color:#ef4444; color:#991b1b;">
        {{ erro }}
    </div>
{% endif %}

<div class="grid-2">
    <!-- FORM -->
    <div class="card">
        <h2>{{ editando ? 'Editar Serviço' : 'Novo Serviço' }}</h2>
        <form method="post" action="{{ base_url }}/servicos{{ editando ? '?edit=' ~ editando.id : '' }}">
            {{ csrfField() }}
            <input type="hidden" name="action" value="{{ editando ? 'update' : 'create' }}">
            {% if editando %}
                <input type="hidden" name="id" value="{{ editando.id }}">
            {% endif %}

            {# ─── Informações Gerais ─── #}
            <fieldset style="border:1px solid #e5e7eb; border-radius:8px; padding:16px; margin-bottom:16px;">
                <legend style="font-weight:600; color:#374151; padding:0 8px;">Informações Gerais</legend>

                <div class="flex-col" style="margin-bottom:12px;">
                    <label>Nome do Serviço *</label>
                    <input type="text" name="nome" required value="{{ editando.nome|default('') }}">
                </div>

                <div class="flex-col" style="margin-bottom:12px;">
                    <label>Descrição</label>
                    <textarea name="descricao" rows="3" style="resize:vertical;">{{ editando.descricao|default('') }}</textarea>
                </div>

                <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:12px;">
                    <div class="flex-col">
                        <label>Especialidade</label>
                        <input type="text" name="especialidade" placeholder="Ex: Psicologia" value="{{ editando.especialidade|default('') }}">
                    </div>
                    <div class="flex-col">
                        <label>Tempo de Atendimento (min)</label>
                        <input type="number" name="tempo_atendimento" min="10" step="5" value="{{ editando.tempo_atendimento|default(60) }}">
                    </div>
                </div>

                <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:12px;">
                    <div class="flex-col">
                        <label>Qtd. de Sessões</label>
                        <input type="number" name="quantidade_sessoes" min="1" value="{{ editando.quantidade_sessoes|default('') }}">
                    </div>
                    <div class="flex-col">
                        <label>Vincular a outro Serviço</label>
                        <select name="servico_vinculado_id">
                            <option value="">Nenhum</option>
                            {% for s in todos_servicos %}
                                {% if not editando or s.id != editando.id %}
                                    <option value="{{ s.id }}" {{ editando.servico_vinculado_id|default('') == s.id ? 'selected' : '' }}>
                                        {{ s.nome }}
                                    </option>
                                {% endif %}
                            {% endfor %}
                        </select>
                    </div>
                </div>
            </fieldset>

            {# ─── Valores ─── #}
            <fieldset style="border:1px solid #e5e7eb; border-radius:8px; padding:16px; margin-bottom:16px;">
                <legend style="font-weight:600; color:#374151; padding:0 8px;">Valores</legend>

                <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:12px;">
                    <div class="flex-col">
                        <label>Valor Base (R$)</label>
                        <input type="number" name="valor_base" step="0.01" min="0" placeholder="0,00" value="{{ editando.valor_base|default('') }}">
                    </div>
                    <div class="flex-col">
                        <label>Valor À Vista (R$)</label>
                        <input type="number" name="valor_avista" step="0.01" min="0" placeholder="0,00" value="{{ editando.valor_avista|default('') }}">
                    </div>
                </div>

                <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:12px;">
                    <div class="flex-col">
                        <label>Valor A Prazo (R$)</label>
                        <input type="number" name="valor_prazo" step="0.01" min="0" placeholder="0,00" value="{{ editando.valor_prazo|default('') }}">
                    </div>
                    <div class="flex-col">
                        <label>Nº Máx. Parcelas</label>
                        <input type="number" name="qtd_parcelas" min="1" value="{{ editando.qtd_parcelas|default('') }}">
                    </div>
                </div>
            </fieldset>

            {% if editando %}
                <div style="margin-bottom:12px;">
                    <label style="display:flex; gap:8px; align-items:center;">
                        <input type="checkbox" name="ativo" style="width:auto; margin:0;" {{ editando.ativo ? 'checked' : '' }}>
                        Ativo
                    </label>
                </div>
            {% endif %}

            <div style="text-align:right;">
                <button type="submit" class="btn-primary">
                    {{ editando ? 'Salvar Alterações' : 'Cadastrar' }}
                </button>
            </div>
        </form>
    </div>

    <!-- LIST -->
    <div class="card">
        <h2>Serviços Cadastrados</h2>
        {% if servicos is empty %}
            <p class="info">Nenhum serviço cadastrado.</p>
        {% else %}
            <table>
                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>Especialidade</th>
                        <th>Tempo</th>
                        <th>Valor Base</th>
                        <th>Status</th>
                        <th style="text-align:right;">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    {% for s in servicos %}
                        <tr style="{{ s.ativo ? '' : 'opacity:0.5;' }}">
                            <td>
                                <strong>{{ s.nome }}</strong>
                                {% if s.servico_vinculado_nome %}
                                    <br><small style="color:#6b7280;">→ {{ s.servico_vinculado_nome }}</small>
                                {% endif %}
                            </td>
                            <td>{{ s.especialidade|default('—') }}</td>
                            <td>{{ s.tempo_atendimento }} min</td>
                            <td>
                                {% if s.valor_base %}
                                    R$ {{ s.valor_base|number_format(2, ',', '.') }}
                                {% else %}
                                    —
                                {% endif %}
                            </td>
                            <td>
                                <span style="font-size:0.8rem; padding:2px 6px; border-radius:4px; background:{{ s.ativo ? '#d1fae5' : '#f3f4f6' }}; color:{{ s.ativo ? '#065f46' : '#6b7280' }};">
                                    {{ s.ativo ? 'Ativo' : 'Inativo' }}
                                </span>
                            </td>
                            <td style="text-align:right;">
                                <a href="{{ base_url }}/servicos?edit={{ s.id }}" class="btn-link">Editar</a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
</div>
{% endblock %}
