{% extends "layouts/base.twig" %}

{% block title %}Salas - Espaço Vital{% endblock %}

{% block content %}
<div class="topbar">
    <h1>Cadastro de Salas</h1>
    {% if editando %}
        <a href="{{ base_url }}/salas" class="btn-secondary">Voltar para Nova</a>
    {% endif %}
</div>

{% if mensagem %}
    <div class="msg-alerta" style="background-color:#d1fae5; border-color:#10b981; color:#065f46;">
        {{ mensagem }}
    </div>
{% endif %}

{% if erro %}
    <div class="msg-alerta" style="background-color:#fee2e2; border-color:#ef4444; color:#991b1b;">
        {{ erro }}
    </div>
{% endif %}

<div class="grid-2">
    <!-- FORM -->
    <div class="card">
        <h2>{{ editando ? 'Editar Sala' : 'Nova Sala' }}</h2>
        <form method="post" action="{{ base_url }}/salas{{ editando ? '?edit=' ~ editando.id : '' }}">
            {{ csrfField() }}
            <input type="hidden" name="action" value="{{ editando ? 'update' : 'create' }}">
            {% if editando %}
                <input type="hidden" name="id" value="{{ editando.id }}">
            {% endif %}

            {# ─── Dados da Sala ─── #}
            <fieldset style="border:1px solid #e5e7eb; border-radius:8px; padding:16px; margin-bottom:16px;">
                <legend style="font-weight:600; color:#374151; padding:0 8px;">Dados da Sala</legend>

                <div class="flex-col" style="margin-bottom:12px;">
                    <label>Nome da Sala *</label>
                    <input type="text" name="nome" required value="{{ editando.nome|default('') }}">
                </div>

                <div class="flex-col" style="margin-bottom:12px;">
                    <label>Descrição</label>
                    <textarea name="descricao" rows="2" style="resize:vertical;">{{ editando.descricao|default('') }}</textarea>
                </div>

                <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px; margin-bottom:12px;">
                    <div class="flex-col">
                        <label>Capacidade (pessoas)</label>
                        <input type="number" name="capacidade" min="1" value="{{ editando.capacidade|default('') }}">
                    </div>
                    <div class="flex-col">
                        <label>Cor na Agenda</label>
                        <input type="color" name="cor_agenda" value="{{ editando.cor_agenda|default('#10B981') }}" style="height:38px; padding:2px;">
                    </div>
                </div>
            </fieldset>

            {# ─── Serviços Permitidos ─── #}
            {% if servicos is not empty %}
            <fieldset style="border:1px solid #e5e7eb; border-radius:8px; padding:16px; margin-bottom:16px;">
                <legend style="font-weight:600; color:#374151; padding:0 8px;">Serviços Permitidos</legend>
                <p style="font-size:0.85rem; color:#6b7280; margin-bottom:10px;">Selecione os tipos de atendimento possíveis nesta sala:</p>
                <div style="display:grid; grid-template-columns:1fr 1fr; gap:6px;">
                    {% for s in servicos %}
                        <label style="display:flex; gap:6px; align-items:center; font-size:0.9rem;">
                            <input type="checkbox" name="servicos[]" value="{{ s.id }}" style="width:auto; margin:0;"
                                {{ s.id in servicosVinculados ? 'checked' : '' }}>
                            {{ s.nome }}
                        </label>
                    {% endfor %}
                </div>
            </fieldset>
            {% endif %}

            {% if editando %}
                <div style="margin-bottom:12px;">
                    <label style="display:flex; gap:8px; align-items:center;">
                        <input type="checkbox" name="ativo" style="width:auto; margin:0;" {{ editando.ativo ? 'checked' : '' }}>
                        Ativa
                    </label>
                </div>
            {% endif %}

            <div style="text-align:right;">
                <button type="submit" class="btn-primary">
                    {{ editando ? 'Salvar Alterações' : 'Cadastrar' }}
                </button>
            </div>
        </form>
    </div>

    <!-- LIST -->
    <div class="card">
        <h2>Salas Cadastradas</h2>
        {% if salas is empty %}
            <p class="info">Nenhum registro.</p>
        {% else %}
            <table>
                <thead>
                    <tr>
                        <th style="width:30px;"></th>
                        <th>Nome</th>
                        <th>Capacidade</th>
                        <th>Status</th>
                        <th style="text-align:right;">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    {% for s in salas %}
                        <tr style="{{ s.ativo ? '' : 'opacity:0.5;' }}">
                            <td>
                                <span style="display:inline-block; width:12px; height:12px; border-radius:50%; background-color:{{ s.cor_agenda|default('#10B981') }};"></span>
                            </td>
                            <td>
                                <strong>{{ s.nome }}</strong>
                                {% if s.descricao %}
                                    <br><small style="color:#6b7280;">{{ s.descricao }}</small>
                                {% endif %}
                            </td>
                            <td>{{ s.capacidade|default('—') }} {{ s.capacidade ? 'pessoas' : '' }}</td>
                            <td>
                                <span style="font-size:0.8rem; padding:2px 6px; border-radius:4px; background:{{ s.ativo ? '#d1fae5' : '#f3f4f6' }}; color:{{ s.ativo ? '#065f46' : '#6b7280' }};">
                                    {{ s.ativo ? 'Ativa' : 'Inativa' }}
                                </span>
                            </td>
                            <td style="text-align:right;">
                                <a href="{{ base_url }}/salas?edit={{ s.id }}" class="btn-link">Editar</a>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        {% endif %}
    </div>
</div>
{% endblock %}
