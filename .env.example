APP_ENV=production
APP_DEBUG=false
APP_TIMEZONE=America/Fortaleza

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=erp_saude
DB_USERNAME=seu_usuario
DB_PASSWORD=sua_senha_segura
DB_CHARSET=utf8mb4

ADMIN_EMAIL=seu_email@clinica.local
ADMIN_PASS=sua_senha_segura

# Google Calendar (opcional — habilita sincronização bidirecional)
# 1. Crie um projeto em console.cloud.google.com
# 2. Habilite a Google Calendar API
# 3. Crie credenciais OAuth2 (tipo: Web Application)
# 4. Adicione a URL de callback abaixo como Redirect URI autorizada
# 5. Acesse /google/auth uma vez para autorizar
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALENDAR_ID=primary
GOOGLE_REDIRECT_URI=https://seudominio.com/google/callback
